{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["overview", "storey_notes"],
  "properties": {
    "overview": {"type": "string", "minLength": 1, "maxLength": 350},
    "storey_notes": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["storey", "text"],
      "properties": {"storey": {"type": "string"}, "text": {"type": "string", "maxLength": 200}}
    }}
  }
}
