{
  "schema_version": "text2ifc/property-resolution-policy/0.1",
  "policy_id": "ifc2x3.single-value.hybrid",
  "version": "0.1",
  "max_candidates": 5,
  "vector_min_score": 0.5,
  "vector_min_margin": 0.03,
  "rules": {
    "canonical_exact": "auto_authorize_unique_applicable_standard",
