{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text2ifc.local/schemas/bim-json/2.0/schema.json",
  "title": "text2IFC BIM JSON 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ifc_schema",
    "units",
    "entities",
    "relationships",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "bim-json/2.0"},
    "ifc_schema": {"const": "IFC2X3"},
    "units": {"$ref": "#/$defs/units"},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length"],
      "properties": {"length": {"const": "MILLIMETRE"}}
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "objectPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_to", "origin", "axis", "ref_direction"],
      "properties": {
        "relative_to": {"$ref": "#/$defs/nonEmptyString"},
        "origin": {"$ref": "#/$defs/vector3"},
        "axis": {"$ref": "#/$defs/vector3"},
        "ref_direction": {"$ref": "#/$defs/vector3"}
      }
    },
    "localPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "axis", "ref_direction"],
      "properties": {
        "origin": {"$ref": "#/$defs/vector3"},
        "axis": {"$ref": "#/$defs/vector3"},
        "ref_direction": {"$ref": "#/$defs/vector3"}
      }
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "profile": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "points": {
          "type": "array",
          "items": {"$ref": "#/$defs/point2"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "rectangle"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["x", "y"]
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "polygon"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["points"]
          }
        }
      ]
    },
    "representation": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "profile": {"$ref": "#/$defs/profile"},
        "depth": {"type": "number"},
        "direction": {"$ref": "#/$defs/vector3"},
        "position": {"$ref": "#/$defs/localPosition"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "extruded_profile"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["profile", "depth", "direction"]
          }
        }
      ]
    },
    "materialLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "thickness"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "thickness": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "materialAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layer_set_name",
        "direction",
        "direction_sense",
        "offset_from_reference_line",
        "layers"
      ],
      "properties": {
        "kind": {"const": "material_layer_set_usage"},
        "layer_set_name": {"$ref": "#/$defs/nonEmptyString"},
        "direction": {"enum": ["AXIS1", "AXIS2", "AXIS3"]},
        "direction_sense": {"enum": ["POSITIVE", "NEGATIVE"]},
        "offset_from_reference_line": {"type": "number"},
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/materialLayer"}
        }
      }
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ObjectPlacement": {"$ref": "#/$defs/objectPlacement"},
        "Representation": {"$ref": "#/$defs/representation"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ifc_class",
        "attributes",
        "property_sets",
        "provenance"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "ifc_class": {"$ref": "#/$defs/nonEmptyString"},
        "global_id": {},
        "attributes": {"$ref": "#/$defs/attributes"},
        "materials": {
          "type": "array",
          "items": {"$ref": "#/$defs/materialAssignment"}
        },
        "property_sets": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ifc_class", "attributes", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "ifc_class": {"$ref": "#/$defs/nonEmptyString"},
        "global_id": {},
        "attributes": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
