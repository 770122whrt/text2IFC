{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-window-occurrence-comparison/0.1",
  "title": "Window and Opening Occurrence Comparison 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_hashes", "mapping", "counts", "details", "truncated", "geometry_relationship_success", "semantic_fidelity_success", "occurrence_fidelity_success", "authoring_exactness"],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-window-occurrence-comparison/0.1"},
    "source_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "mapping": {"type": "object"},
    "counts": {
      "type": "object",
      "required": ["matched", "not_in_user_text", "unsupported_authoring", "wrong_value", "ownership_only"],
      "properties": {
        "matched": {"type": "integer", "minimum": 0},
        "not_in_user_text": {"type": "integer", "minimum": 0},
        "unsupported_authoring": {"type": "integer", "minimum": 0},
        "wrong_value": {"type": "integer", "minimum": 0},
        "ownership_only": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "details": {"type": "array", "items": {"$ref": "#/$defs/detail"}},
    "truncated": {"type": "boolean"},
    "detail_total": {"type": "integer", "minimum": 0},
    "geometry_relationship_success": {"type": "boolean"},
    "semantic_fidelity_success": {"type": "boolean"},
    "occurrence_fidelity_success": {"type": "boolean"},
    "authoring_exactness": {"type": "boolean"}
  },
  "$defs": {
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_key", "classification", "required", "expected", "actual"],
      "properties": {
        "fact_key": {"type": "string", "minLength": 1},
        "classification": {"enum": ["matched", "not_in_user_text", "unsupported_authoring", "wrong_value", "ownership_only"]},
        "required": {"type": "boolean"},
        "expected": {"type": ["object", "null"]},
        "actual": {"type": ["object", "null"]}
      }
    }
  }
}
