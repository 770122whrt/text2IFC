{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-changeset-draft/0.4",
  "title": "Provider IFC Repair ChangeSet Draft 0.4 with Appearance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "base_model_fingerprint",
    "source_request_hash",
    "semantic_manifest_ref",
    "semantic_manifest_sha256",
    "semantic_summary",
    "scope",
    "evidence_refs",
    "preconditions",
    "postconditions",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-changeset-draft/0.4"},
    "draft_id": {"$ref": "#/$defs/id"},
    "base_model_fingerprint": {"$ref": "#/$defs/hash"},
    "source_request_hash": {"$ref": "#/$defs/hash"},
    "semantic_manifest_ref": {"type": "string", "minLength": 1},
    "semantic_manifest_sha256": {"$ref": "#/$defs/hash"},
    "semantic_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "conditional", "not_required"],
      "properties": {
        "required": {"type": "integer", "minimum": 0},
        "conditional": {"type": "integer", "minimum": 0},
        "not_required": {"type": "integer", "minimum": 0}
      }
    },
    "scope": {"$ref": "#/$defs/scope"},
    "evidence_refs": {"$ref": "#/$defs/strings"},
    "preconditions": {"$ref": "#/$defs/strings"},
    "postconditions": {"$ref": "#/$defs/strings"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ids", "forbidden_ids"],
      "properties": {
        "target_ids": {"$ref": "#/$defs/strings"},
        "forbidden_ids": {"$ref": "#/$defs/strings"}
      }
    },
    "appearance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["intent_kind", "red", "green", "blue"],
          "properties": {
            "intent_kind": {"const": "surface_color_rgb"},
            "red": {"type": "number", "minimum": 0, "maximum": 1},
            "green": {"type": "number", "minimum": 0, "maximum": 1},
            "blue": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation_type",
        "target",
        "parameters",
        "evidence_refs",
        "appearance"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "operation_type": {"$ref": "#/$defs/id"},
        "target": {"type": "object", "minProperties": 1},
        "parameters": {"type": "object"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "appearance": {"$ref": "#/$defs/appearance"}
      }
    }
  }
}
