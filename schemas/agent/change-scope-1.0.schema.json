{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text2ifc.local/schemas/agent/change-scope-1.0.schema.json",
  "title": "text2IFC Change Scope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "base_revision_id",
    "source_issue_ids",
    "entity_ids",
    "relationship_ids",
    "allowed_paths",
    "dependencies",
    "forbidden_ids"
  ],
  "properties": {
    "schema_version": {"const": "text2ifc/change-scope/1.0"},
    "scope_id": {"$ref": "#/$defs/stableId"},
    "base_revision_id": {"$ref": "#/$defs/stableId"},
    "source_issue_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "entity_ids": {"$ref": "#/$defs/idList"},
    "relationship_ids": {"$ref": "#/$defs/idList"},
    "allowed_paths": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/stableId"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^/(?![0-9]+(?:/|$)).+"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "dependency_id", "relationship_type", "reason"],
        "properties": {
          "target_id": {"$ref": "#/$defs/stableId"},
          "dependency_id": {"$ref": "#/$defs/stableId"},
          "relationship_type": {"$ref": "#/$defs/stableId"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "forbidden_ids": {"$ref": "#/$defs/idList"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    }
  }
}
