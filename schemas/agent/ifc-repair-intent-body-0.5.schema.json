{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-intent-body/0.5",
  "title": "IFC Repair Intent Semantic Body 0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operations", "semantic_bundles", "provenance"],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-intent-body/0.5"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/operation"}},
    "semantic_bundles": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/semantic_bundle"}},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/provenance"}}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "nullable_text": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "reference", "excerpt"],
      "properties": {
        "source_kind": {"enum": ["user_request", "public_capability", "public_clarification"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "attribute_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_kind", "name", "value", "source"],
      "properties": {
        "intent_kind": {"enum": ["attribute", "material"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "value": {"$ref": "#/$defs/scalar"},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "exact_property": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_kind", "set_name", "property_name", "raw_value", "raw_unit", "requested_value_type", "scope", "source"],
      "properties": {
        "intent_kind": {"const": "exact_property"},
        "set_name": {"$ref": "#/$defs/nullable_text"},
        "property_name": {"$ref": "#/$defs/nullable_text"},
        "raw_value": {"$ref": "#/$defs/scalar"},
        "raw_unit": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
        "requested_value_type": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$", "maxLength": 128}]},
        "scope": {"enum": ["occurrence_direct", "type_owned", null]},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "natural_language_property": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_kind", "property_phrase", "raw_value", "raw_unit", "scope", "source"],
      "properties": {
        "intent_kind": {"const": "natural_language_property"},
        "property_phrase": {"$ref": "#/$defs/nullable_text"},
        "raw_value": {"$ref": "#/$defs/scalar"},
        "raw_unit": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
        "scope": {"enum": ["occurrence_direct", "type_owned", null]},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "property_claim": {"oneOf": [{"$ref": "#/$defs/exact_property"}, {"$ref": "#/$defs/natural_language_property"}]},
    "quantity_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "set_name", "quantity_name", "value", "value_type", "unit", "source"],
      "properties": {
        "scope": {"enum": ["window_occurrence", "door_occurrence", "opening_occurrence"]},
        "set_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "quantity_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "value": {"type": ["number", "integer", "boolean", "string"]},
        "value_type": {"enum": ["IfcQuantityLength", "IfcQuantityArea"]},
        "unit": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "occurrence_reuse_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "reference_kind", "reference", "include_patterns", "source"],
      "properties": {
        "mode": {"enum": ["exact_occurrence", "same_type_consensus"]},
        "reference_kind": {"enum": ["global_id", "name", "type_global_id", "type_name"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "include_patterns": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "semantic_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_id", "property_intents", "quantity_intents", "provenance"],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
        "property_intents": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/property_claim"}},
        "quantity_intents": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/quantity_intent"}},
        "provenance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "prototype_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_kind", "reference", "source"],
      "properties": {
        "reference_kind": {"enum": ["global_id", "type_name", "selection_required"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "routing_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["component_family", "action", "operation_profile", "source"],
      "properties": {
        "component_family": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
        "action": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
        "operation_profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9._-]*$"},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "target_query": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "allowed_ifc_classes"],
      "properties": {
        "schema_version": {"const": "text2ifc/ifc-target-query/0.1"},
        "allowed_ifc_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"}},
        "global_id": {"type": ["string", "null"]},
        "names": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "storey_name": {"type": ["string", "null"]},
        "storey_global_id": {"type": ["string", "null"]},
        "host_global_id": {"type": ["string", "null"]},
        "grid": {"type": ["string", "null"]},
        "space": {"type": ["string", "null"]},
        "direction": {"type": ["string", "null"]},
        "geometry_capabilities": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "attribute_intents": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
        "winner_margin": {"type": "integer", "minimum": 1}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "operation_type", "routing_intent", "target_query", "parameters", "attribute_intents", "property_intents", "semantic_bundle_refs", "quantity_intents", "occurrence_reuse_intent", "prototype_intent", "provenance"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "routing_intent": {"$ref": "#/$defs/routing_intent"},
        "target_query": {"$ref": "#/$defs/target_query"},
        "parameters": {"type": "object", "maxProperties": 64},
        "attribute_intents": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/attribute_intent"}},
        "property_intents": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/property_claim"}},
        "semantic_bundle_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "quantity_intents": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/quantity_intent"}},
        "occurrence_reuse_intent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/occurrence_reuse_intent"}]},
        "prototype_intent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/prototype_intent"}]},
        "provenance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/provenance"}}
      }
    }
  }
}
