{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-stage2-operation/0.1",
  "title": "Beam or Column Stage 2 Draft Operation 0.1",
  "oneOf": [
    {"$ref": "#/$defs/beam"},
    {"$ref": "#/$defs/column"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["x_mm", "y_mm", "z_mm"],
      "properties": {"x_mm": {"type": "number"}, "y_mm": {"type": "number"}, "z_mm": {"type": "number"}}
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["storey_global_id"],
      "properties": {"storey_global_id": {"type": "string", "minLength": 1}}
    },
    "beamParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["axis", "section"],
      "properties": {
        "axis": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {"start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}}
        },
        "section": {
          "type": "object", "additionalProperties": false,
          "required": ["shape", "width_mm", "height_mm"],
          "properties": {
            "shape": {"const": "rectangle"},
            "width_mm": {"type": "number", "exclusiveMinimum": 0},
            "height_mm": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "columnParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["axis", "section"],
      "properties": {
        "axis": {
          "type": "object", "additionalProperties": false,
          "required": ["base", "top"],
          "properties": {"base": {"$ref": "#/$defs/point"}, "top": {"$ref": "#/$defs/point"}}
        },
        "section": {
          "type": "object", "additionalProperties": false,
          "required": ["shape", "width_mm", "depth_mm"],
          "properties": {
            "shape": {"const": "rectangle"},
            "width_mm": {"type": "number", "exclusiveMinimum": 0},
            "depth_mm": {"type": "number", "exclusiveMinimum": 0},
            "orientation": {
              "type": "object", "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
            }
          }
        }
      }
    },
    "beam": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "operation_type", "target", "parameters", "evidence_refs"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "operation_type": {"const": "add_beam"},
        "target": {"$ref": "#/$defs/target"},
        "parameters": {"$ref": "#/$defs/beamParameters"},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "column": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "operation_type", "target", "parameters", "evidence_refs"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"},
        "operation_type": {"const": "add_column"},
        "target": {"$ref": "#/$defs/target"},
        "parameters": {"$ref": "#/$defs/columnParameters"},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
