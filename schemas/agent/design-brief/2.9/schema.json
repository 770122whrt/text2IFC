{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text2ifc.local/schemas/agent/design-brief/2.9/schema.json",
  "title": "text2IFC Parameterized Door and Window Component Design Brief 2.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "original_request",
    "status",
    "known_facts",
    "fact_sources",
    "missing_facts",
    "ambiguities",
    "unsupported_requests",
    "user_corrections",
    "clarification_questions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "text2ifc/design-brief/2.9"
    },
    "language": {
      "const": "zh-CN"
    },
    "original_request": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "draft_required",
        "blocked"
      ]
    },
    "known_facts": {
      "type": "object",
      "properties": {
        "semantic_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity_id"
            ],
            "properties": {
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "direct",
                  "effective",
                  "inherited"
                ]
              },
              "material": {
                "type": "object"
              },
              "property_sets": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              },
              "type_id": {
                "type": "string",
                "minLength": 1
              },
              "appearance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "transparency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "minProperties": 1
              },
              "template": {
                "type": "object"
              },
              "source": {
                "enum": [
                  "user",
                  "deterministic_derivation",
                  "allowed_design_choice"
                ]
              },
              "part_appearance": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "frame": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "color": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "transparency": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "panel": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "color": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "transparency": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "glazing": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "color": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "transparency": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              },
              "component_geometry": {
                "$ref": "#/$defs/componentGeometry"
              }
            }
          }
        },
        "appearance": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string"
            },
            "seed": {
              "type": "string"
            }
          }
        },
        "semantic_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "material",
            "property",
            "type",
            "appearance",
            "template",
            "component_geometry"
          ],
          "properties": {
            "material": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_turns"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "specified",
                    "not_specified",
                    "unresolved"
                  ]
                },
                "source_turns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "property": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_turns"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "specified",
                    "not_specified",
                    "unresolved"
                  ]
                },
                "source_turns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_turns"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "specified",
                    "not_specified",
                    "unresolved"
                  ]
                },
                "source_turns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "appearance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_turns"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "specified",
                    "not_specified",
                    "unresolved"
                  ]
                },
                "source_turns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "template": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_turns"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "specified",
                    "not_specified",
                    "unresolved"
                  ]
                },
                "source_turns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "component_geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_turns"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "specified",
                    "not_specified",
                    "unresolved"
                  ]
                },
                "source_turns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "plan_constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "outline_ref",
                  "storey_ref",
                  "thickness_mm",
                  "derived_wall_ids",
                  "source_turns"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "inside_wall_envelope"
                  },
                  "outline_ref": {
                    "type": "string",
                    "pattern": "^/known_facts/"
                  },
                  "storey_ref": {
                    "type": "string",
                    "pattern": "^/known_facts/"
                  },
                  "thickness_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "derived_wall_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "source_turns": {
                    "$ref": "#/$defs/stringList"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "outline_ref",
                  "storey_ref",
                  "derived_wall_ids",
                  "source_turns",
                  "checks"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "wall_layout"
                  },
                  "outline_ref": {
                    "type": "string",
                    "pattern": "^/known_facts/"
                  },
                  "storey_ref": {
                    "type": "string",
                    "pattern": "^/known_facts/"
                  },
                  "derived_wall_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "source_turns": {
                    "$ref": "#/$defs/stringList"
                  },
                  "checks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "inside_outline",
                        "non_overlapping"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "semantic_requirements",
        "semantic_review",
        "plan_constraints"
      ]
    },
    "fact_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factSource"
      }
    },
    "missing_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingFact"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "unsupported_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unsupportedRequest"
      }
    },
    "user_corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      }
    },
    "clarification_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "clarification_questions": {
            "minItems": 1,
            "maxItems": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "clarification_questions": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^/"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "factSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_turns",
        "evidence_refs"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "source_turns": {
          "$ref": "#/$defs/stringList"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "missingFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "path",
        "message",
        "reason",
        "blocking",
        "evidence_refs",
        "source_turns"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocking": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "source_turns": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "message",
        "reason",
        "blocking",
        "evidence_refs",
        "source_turns",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocking": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "source_turns": {
          "$ref": "#/$defs/stringList"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {}
        }
      }
    },
    "unsupportedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "message",
        "reason",
        "blocking",
        "requested_value",
        "evidence_refs",
        "source_turns"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blocking": {
          "type": "boolean"
        },
        "requested_value": {},
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "source_turns": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value",
        "source_turn",
        "evidence_refs"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "value": {},
        "source_turn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "replaces": {},
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "targets",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targets": {
          "$ref": "#/$defs/stringList"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_turns",
        "selected_evidence_ids",
        "few_shot_ids"
      ],
      "properties": {
        "source_turns": {
          "$ref": "#/$defs/stringList"
        },
        "selected_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "few_shot_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "componentGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "geometry_version",
        "definitions",
        "parts"
      ],
      "properties": {
        "kind": {
          "const": "component_geometry"
        },
        "geometry_version": {
          "const": "text2ifc/components/1.0"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentDefinition"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentPart"
          },
          "minItems": 1,
          "maxItems": 512
        }
      }
    },
    "componentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "geometry_refs",
        "placement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "geometry_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "placement": {
          "$ref": "#/$defs/localPosition"
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "step"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 512
            },
            "step": {
              "$ref": "#/$defs/vector3"
            }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "transparency"
          ],
          "properties": {
            "color": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "transparency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "position",
        "direction",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
        },
        "profile": {
          "$ref": "#/$defs/componentProfile"
        },
        "position": {
          "$ref": "#/$defs/localPosition"
        },
        "direction": {
          "$ref": "#/$defs/vector3"
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        }
      }
    },
    "componentProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "rectangle"
            },
            "x": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000000
            },
            "y": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "radius"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "points"
          ],
          "properties": {
            "kind": {
              "const": "polygon"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point2"
              },
              "minItems": 4,
              "maxItems": 257
            },
            "holes": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/point2"
                },
                "minItems": 4,
                "maxItems": 257
              },
              "minItems": 0,
              "maxItems": 16
            }
          }
        }
      ]
    },
    "localPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "axis",
        "ref_direction"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/vector3"
        },
        "axis": {
          "$ref": "#/$defs/vector3"
        },
        "ref_direction": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    }
  }
}
