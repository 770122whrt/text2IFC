{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text2ifc.local/schemas/agent/bim-json-revision-1.0.schema.json",
  "title": "text2IFC BIM JSON Revision 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "sequence",
    "parent_revision_id",
    "candidate_hash",
    "expected_facts_hash",
    "component_hashes",
    "source_route",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "text2ifc/bim-json-revision/1.0"},
    "revision_id": {"$ref": "#/$defs/stableId"},
    "sequence": {"type": "integer", "minimum": 0},
    "parent_revision_id": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/stableId"}]
    },
    "candidate_hash": {"$ref": "#/$defs/sha256"},
    "expected_facts_hash": {"$ref": "#/$defs/sha256"},
    "component_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/stableId"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "source_route": {
      "enum": ["initial_generation", "staged_composition", "changeset"]
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/stableId"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:|/|\\\\).+"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
