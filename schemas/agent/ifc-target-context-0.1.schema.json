{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-target-context/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_model_fingerprint", "query_schema_version", "resolution_schema_version", "score_version", "status", "resolved_target_id", "operation_hints", "candidate_targets", "model_constraints", "context_budget"],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-target-context/0.1"},
    "base_model_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "query_schema_version": {"const": "text2ifc/ifc-target-query/0.1"},
    "resolution_schema_version": {"const": "text2ifc/ifc-target-resolution/0.1"},
    "score_version": {"const": "text2ifc/target-score/0.1"},
    "status": {"enum": ["resolved", "ambiguous", "not_found", "conflict", "unsupported"]},
    "resolved_target_id": {"type": ["string", "null"]},
    "operation_hints": {"type": "array", "items": {"type": "string"}},
    "candidate_targets": {"type": "array", "maxItems": 10, "items": {"type": "object"}},
    "model_constraints": {"type": "object"},
    "context_budget": {
      "type": "object",
      "required": ["mode", "max_candidates", "max_bytes", "selected_candidate_count", "omitted_candidate_count", "actual_bytes", "estimated_tokens", "token_estimator"],
      "properties": {
        "mode": {"enum": ["normal", "diagnostic"]},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_bytes": {"type": "integer", "minimum": 1},
        "selected_candidate_count": {"type": "integer", "minimum": 0},
        "omitted_candidate_count": {"type": "integer", "minimum": 0},
        "actual_bytes": {"type": "integer", "minimum": 1},
        "estimated_tokens": {"type": "integer", "minimum": 1},
        "token_estimator": {"const": "ceil(utf8_bytes/4)"}
      }
    }
  }
}
