{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-clarification/0.1",
  "title": "IFC Repair Clarification 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "clarification_id", "run_id", "state_version",
    "operation_id", "stage", "resume_stage", "reason_code", "question",
    "answer_modes", "answer_schema", "candidates", "property_preview"
  ],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-clarification/0.1"},
    "clarification_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "pattern": "^repair-[a-z0-9][a-z0-9-]{0,95}$"},
    "state_version": {"type": "integer", "minimum": 1},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "stage": {"type": "string", "minLength": 1, "maxLength": 64},
    "resume_stage": {"type": "string", "minLength": 1, "maxLength": 64},
    "reason_code": {
      "enum": [
        "ambiguous_target", "selector_conflict", "missing_required_parameter",
        "prototype_selection", "additional_target_detail", "property_confirmation"
      ]
    },
    "question": {"type": "string", "minLength": 1, "maxLength": 4096},
    "answer_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["select_candidate", "add_detail", "authorize_prototype", "confirm_property", "reject_property", "cancel"]}
    },
    "answer_schema": {"type": "object"},
    "candidates": {
      "type": "array", "maxItems": 20,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "property_preview": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id", "target_global_id", "request_hash", "model_fingerprint",
            "set_name", "property_name", "value", "value_type", "unit", "scope",
            "source", "preview_hash"
          ],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "target_global_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "model_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "set_name": {"type": "string", "minLength": 1, "maxLength": 512},
            "property_name": {"type": "string", "minLength": 1, "maxLength": 512},
            "value": {"type": ["string", "number", "integer", "boolean"]},
            "value_type": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
            "unit": {"type": ["string", "null"], "maxLength": 128},
            "scope": {"const": "occurrence_direct"},
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_kind", "reference", "excerpt"],
              "properties": {
                "source_kind": {"type": "string", "minLength": 1},
                "reference": {"type": "string", "minLength": 1},
                "excerpt": {"type": "string", "minLength": 1, "maxLength": 4096}
              }
            },
            "preview_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token", "public_id", "ifc_class", "name", "storey", "position",
        "evidence", "candidate_kind", "dimensions", "occurrence_count", "storeys"
      ],
      "properties": {
        "token": {"type": "string", "minLength": 1, "maxLength": 128},
        "public_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ifc_class": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
        "name": {"type": ["string", "null"], "maxLength": 512},
        "storey": {"type": ["string", "null"], "maxLength": 512},
        "position": {"type": ["string", "null"], "maxLength": 1024},
        "candidate_kind": {"enum": ["target", "type"]},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width_mm": {"type": "number"},
            "height_mm": {"type": "number"},
            "sill_height_mm": {"type": "number"}
          }
        },
        "occurrence_count": {"type": "integer", "minimum": 0},
        "storeys": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "evidence": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
