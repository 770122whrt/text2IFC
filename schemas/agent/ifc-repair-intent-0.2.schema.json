{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-intent/0.2",
  "title": "IFC Repair Intent 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "source_request_hash",
    "model_fingerprint",
    "prompt_fingerprint",
    "operations",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-intent/0.2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_request_hash": {"$ref": "#/$defs/sha256"},
    "model_fingerprint": {"$ref": "#/$defs/sha256"},
    "prompt_fingerprint": {"$ref": "#/$defs/sha256"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/operation"}
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/provenance"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "reference", "excerpt"],
      "properties": {
        "source_kind": {
          "enum": ["user_request", "public_capability", "public_clarification"]
        },
        "reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "attribute_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_kind", "name", "value", "source"],
      "properties": {
        "intent_kind": {"enum": ["attribute", "material"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "value": {"type": ["string", "number", "integer", "boolean", "null"]},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "property_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_kind",
        "set_name",
        "property_name",
        "value",
        "requested_value_type",
        "requested_unit",
        "scope",
        "source"
      ],
      "properties": {
        "intent_kind": {"const": "pset_property"},
        "set_name": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "property_name": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "value": {"type": ["string", "number", "integer", "boolean", "null"]},
        "requested_value_type": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$", "maxLength": 128}
          ]
        },
        "requested_unit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 128}
          ]
        },
        "scope": {"enum": ["occurrence_direct", "type_owned", null]},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "prototype_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "reference", "source"],
      "properties": {
        "reference_kind": {
          "enum": ["global_id", "type_name", "selection_required"]
        },
        "reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"$ref": "#/$defs/provenance"}
      }
    },
    "target_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "allowed_ifc_classes"],
      "properties": {
        "schema_version": {"const": "text2ifc/ifc-target-query/0.1"},
        "allowed_ifc_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"}
        },
        "global_id": {"type": ["string", "null"]},
        "names": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "storey_name": {"type": ["string", "null"]},
        "storey_global_id": {"type": ["string", "null"]},
        "host_global_id": {"type": ["string", "null"]},
        "grid": {"type": ["string", "null"]},
        "space": {"type": ["string", "null"]},
        "direction": {"type": ["string", "null"]},
        "geometry_capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "attribute_intents": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "object"}
        },
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
        "winner_margin": {"type": "integer", "minimum": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation_type",
        "target_query",
        "parameters",
        "attribute_intents",
        "property_intents",
        "prototype_intent",
        "provenance"
      ],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_query": {"$ref": "#/$defs/target_query"},
        "parameters": {"type": "object", "maxProperties": 64},
        "attribute_intents": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/attribute_intent"}
        },
        "property_intents": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/property_intent"}
        },
        "prototype_intent": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/prototype_intent"}]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/provenance"}
        }
      }
    }
  }
}
