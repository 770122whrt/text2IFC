{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-proof-profiles/0.1",
  "title": "IFC Repair Frozen Proof Profiles 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance_namespace", "freeze", "execution_order", "cases"],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-proof-profiles/0.1"},
    "provenance_namespace": {"const": "repair-milestone-r1"},
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "case_id", "provenance_namespace", "terminal_class", "artifact_predicates"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "provenance_namespace": {"const": "repair-milestone-r1"},
        "terminal_class": {"enum": ["SUCCESS", "CLARIFICATION_THEN_SUCCESS", "INADMISSIBLE_VALUE_OR_CLARIFICATION", "UNSUPPORTED_ATOMIC_GUARD"]},
        "property_claim_count": {"type": "integer", "minimum": 0},
        "terminal_expectation": {"type": "object", "additionalProperties": true},
        "artifact_predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["predicate_id", "kind"],
            "properties": {
              "predicate_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["occurrence_property", "occurrence_preservation", "structural_add", "atomic_operation_set"]}
            }
          }
        }
      }
    }
  }
}
