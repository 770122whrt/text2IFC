{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-property-candidate-set/0.1",
  "title": "IFC Property Candidate Set 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_set_id",
    "query_id",
    "corpus_version",
    "embedding_model",
    "document_renderer_version",
    "collection_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "text2ifc/ifc-property-candidate-set/0.1"
    },
    "candidate_set_id": {
      "$ref": "#/$defs/stable_id"
    },
    "query_id": {
      "$ref": "#/$defs/stable_id"
    },
    "corpus_version": {
      "$ref": "#/$defs/version"
    },
    "embedding_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "document_renderer_version": {
      "$ref": "#/$defs/version"
    },
    "collection_version": {
      "$ref": "#/$defs/version"
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "record_id",
        "rank",
        "score",
        "canonical_path",
        "set_name",
        "property_name",
        "definition",
        "applicable_classes",
        "template_type",
        "value_type",
        "unit",
        "standard_status",
        "source"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_id": {
          "$ref": "#/$defs/stable_id"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "canonical_path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
        },
        "set_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "property_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "applicable_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^Ifc[A-Za-z0-9]+$"
          }
        },
        "template_type": {
          "const": "TypePropertySingleValue"
        },
        "value_type": {
          "type": "string",
          "pattern": "^Ifc[A-Za-z0-9]+$",
          "maxLength": 128
        },
        "unit": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "standard_status": {
          "enum": ["standard", "project_custom"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {
              "enum": ["ifc2x3_psd", "project_record"]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
