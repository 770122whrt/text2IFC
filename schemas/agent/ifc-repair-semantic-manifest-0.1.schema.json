{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-semantic-manifest/0.1",
  "title": "IFC Repair Semantic Authoring Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "operation_id",
    "operation_type",
    "base_model_fingerprint",
    "policy",
    "assignments"
  ],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-semantic-manifest/0.1"},
    "manifest_id": {"$ref": "#/$defs/stableId"},
    "operation_id": {"$ref": "#/$defs/stableId"},
    "operation_type": {"$ref": "#/$defs/stableId"},
    "base_model_fingerprint": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/stableId"},
        "policy_version": {"pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assignment"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "fact_key",
        "source_fact_key",
        "value",
        "value_type",
        "unit",
        "ownership",
        "applicability",
        "source_kind",
        "source_ref",
        "provenance",
        "authoring_action"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/stableId"},
        "fact_key": {"$ref": "#/$defs/stableId"},
        "source_fact_key": {"$ref": "#/$defs/nonEmptyString"},
        "value": {},
        "value_type": {"$ref": "#/$defs/nonEmptyString"},
        "unit": {"type": ["string", "null"]},
        "ownership": {"enum": ["occurrence_direct", "type_inherited"]},
        "applicability": {"enum": ["required", "conditional"]},
        "source_kind": {
          "enum": [
            "explicit_request",
            "surviving_target",
            "surviving_host",
            "surviving_type",
            "authorized_type_cohort",
            "approved_prototype",
            "deterministic_policy"
          ]
        },
        "source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "authoring_action": {
          "enum": [
            "set_attribute",
            "set_occurrence_pset",
            "set_quantity",
            "reuse_material",
            "reuse_classification",
            "bind_relationship",
            "inherit_from_type"
          ]
        }
      }
    }
  }
}
