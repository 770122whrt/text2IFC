{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-scene-grounding-response/0.2",
  "title": "Public IFC scene grounding 0.2",
  "$defs": {
    "intent_body": {
      "title": "IFC Repair Intent Semantic Body 0.10",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operations",
        "unsupported_requests",
        "semantic_bundles",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "text2ifc/ifc-repair-intent-body/0.10"
        },
        "operations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/intent_body/$defs/operation"
          }
        },
        "unsupported_requests": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/intent_body/$defs/unsupported_request"
          }
        },
        "semantic_bundles": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/intent_body/$defs/semantic_bundle"
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/intent_body/$defs/provenance"
          }
        }
      },
      "$defs": {
        "scalar": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "nullable_text": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_kind",
            "reference",
            "excerpt"
          ],
          "properties": {
            "source_kind": {
              "enum": [
                "user_request",
                "public_capability",
                "public_clarification"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "excerpt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "user_request"
                  }
                },
                "required": [
                  "source_kind"
                ]
              },
              "then": {
                "properties": {
                  "reference": {
                    "const": "request:/text"
                  }
                }
              }
            }
          ]
        },
        "attribute_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_kind",
            "name",
            "value",
            "source"
          ],
          "properties": {
            "intent_kind": {
              "enum": [
                "attribute",
                "material"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "value": {
              "$ref": "#/$defs/intent_body/$defs/scalar"
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "intent_kind": {
                    "const": "material"
                  }
                },
                "required": [
                  "intent_kind"
                ]
              },
              "then": {
                "properties": {
                  "name": {
                    "const": "Material"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          ]
        },
        "exact_property": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_kind",
            "set_name",
            "property_name",
            "raw_value",
            "raw_unit",
            "requested_value_type",
            "scope",
            "source"
          ],
          "properties": {
            "intent_kind": {
              "const": "exact_property"
            },
            "set_name": {
              "$ref": "#/$defs/intent_body/$defs/nullable_text"
            },
            "property_name": {
              "$ref": "#/$defs/intent_body/$defs/nullable_text"
            },
            "raw_value": {
              "$ref": "#/$defs/intent_body/$defs/scalar"
            },
            "raw_unit": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            "requested_value_type": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^Ifc[A-Za-z0-9]+$",
                  "maxLength": 128
                }
              ]
            },
            "scope": {
              "enum": [
                "occurrence_direct",
                "type_owned",
                null
              ]
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        },
        "natural_language_property": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_kind",
            "property_phrase",
            "raw_value",
            "raw_unit",
            "scope",
            "source"
          ],
          "properties": {
            "intent_kind": {
              "const": "natural_language_property"
            },
            "property_phrase": {
              "$ref": "#/$defs/intent_body/$defs/nullable_text"
            },
            "raw_value": {
              "$ref": "#/$defs/intent_body/$defs/scalar"
            },
            "raw_unit": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            "scope": {
              "enum": [
                "occurrence_direct",
                "type_owned",
                null
              ]
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        },
        "property_claim": {
          "oneOf": [
            {
              "$ref": "#/$defs/intent_body/$defs/exact_property"
            },
            {
              "$ref": "#/$defs/intent_body/$defs/natural_language_property"
            }
          ]
        },
        "quantity_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "set_name",
            "quantity_name",
            "value",
            "value_type",
            "unit",
            "source"
          ],
          "properties": {
            "scope": {
              "enum": [
                "window_occurrence",
                "door_occurrence",
                "opening_occurrence",
                "beam_occurrence",
                "column_occurrence"
              ]
            },
            "set_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "quantity_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "value": {
              "type": [
                "number",
                "integer",
                "boolean",
                "string"
              ]
            },
            "value_type": {
              "enum": [
                "IfcQuantityLength",
                "IfcQuantityArea"
              ]
            },
            "unit": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        },
        "occurrence_reuse_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "reference_kind",
            "reference",
            "include_patterns",
            "source"
          ],
          "properties": {
            "mode": {
              "enum": [
                "exact_occurrence",
                "same_type_consensus"
              ]
            },
            "reference_kind": {
              "enum": [
                "global_id",
                "name",
                "type_global_id",
                "type_name"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "include_patterns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        },
        "semantic_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundle_id",
            "property_intents",
            "quantity_intents",
            "provenance"
          ],
          "properties": {
            "bundle_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "property_intents": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/property_claim"
              }
            },
            "quantity_intents": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/quantity_intent"
              }
            },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/provenance"
              }
            }
          }
        },
        "prototype_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference_kind",
            "reference",
            "source"
          ],
          "properties": {
            "reference_kind": {
              "enum": [
                "global_id",
                "type_name",
                "selection_required"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        },
        "routing_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_family",
            "action",
            "operation_profile",
            "source"
          ],
          "properties": {
            "component_family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "operation_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        },
        "target_query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "allowed_ifc_classes"
          ],
          "properties": {
            "schema_version": {
              "const": "text2ifc/ifc-target-query/0.1"
            },
            "allowed_ifc_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^Ifc[A-Za-z0-9]+$"
              }
            },
            "global_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "names": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "storey_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "storey_global_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "host_global_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "grid": {
              "type": [
                "string",
                "null"
              ]
            },
            "space": {
              "type": [
                "string",
                "null"
              ]
            },
            "direction": {
              "type": [
                "string",
                "null"
              ]
            },
            "geometry_capabilities": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "geometry_constraints": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "value"
                ],
                "properties": {
                  "field": {
                    "enum": [
                      "storey_elevation_mm",
                      "wall_length_mm",
                      "wall_height_mm",
                      "wall_thickness_mm",
                      "opening_width_mm",
                      "opening_height_mm",
                      "opening_depth_mm",
                      "opening_center_offset_mm",
                      "opening_sill_height_mm",
                      "opening_normal_offset_mm"
                    ]
                  },
                  "value": {
                    "type": "number"
                  },
                  "tolerance_mm": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            },
            "attribute_intents": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object"
              }
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "winner_margin": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "operation_type",
            "routing_intent",
            "target_query",
            "parameters",
            "attribute_intents",
            "property_intents",
            "semantic_bundle_refs",
            "quantity_intents",
            "occurrence_reuse_intent",
            "prototype_intent",
            "provenance",
            "appearance_intent"
          ],
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operation_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "routing_intent": {
              "$ref": "#/$defs/intent_body/$defs/routing_intent"
            },
            "target_query": {
              "$ref": "#/$defs/intent_body/$defs/target_query"
            },
            "parameters": {
              "type": "object",
              "maxProperties": 64
            },
            "attribute_intents": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/attribute_intent"
              }
            },
            "property_intents": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/property_claim"
              }
            },
            "semantic_bundle_refs": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "quantity_intents": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/quantity_intent"
              }
            },
            "occurrence_reuse_intent": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/intent_body/$defs/occurrence_reuse_intent"
                }
              ]
            },
            "prototype_intent": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/intent_body/$defs/prototype_intent"
                }
              ]
            },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/intent_body/$defs/provenance"
              }
            },
            "appearance_intent": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/intent_body/$defs/appearance_intent"
                }
              ]
            }
          }
        },
        "unsupported_request": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unsupported_id",
                "kind",
                "operation_id",
                "capability_id",
                "source"
              ],
              "properties": {
                "unsupported_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "kind": {
                  "const": "registered_capability"
                },
                "operation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "capability_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "source": {
                  "$ref": "#/$defs/intent_body/$defs/provenance"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unsupported_id",
                "kind",
                "operation_id",
                "capability_id",
                "source"
              ],
              "properties": {
                "unsupported_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "kind": {
                  "const": "unregistered_action"
                },
                "operation_id": {
                  "type": "null"
                },
                "capability_id": {
                  "const": "unregistered_operation"
                },
                "source": {
                  "$ref": "#/$defs/intent_body/$defs/provenance"
                }
              }
            }
          ]
        },
        "appearance_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_kind",
            "red",
            "green",
            "blue",
            "source"
          ],
          "properties": {
            "intent_kind": {
              "const": "surface_color_rgb"
            },
            "red": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "green": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "source": {
              "$ref": "#/$defs/intent_body/$defs/provenance"
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "operations": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "unsupported_requests": {
              "minItems": 1
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "query"
      ],
      "properties": {
        "kind": {
          "const": "query"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ifc_classes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "storey_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "host_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "order_by": {
              "enum": [
                "id",
                "world_x",
                "world_y",
                "world_z"
              ]
            },
            "descending": {
              "type": "boolean"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80
            },
            "world_bounds_mm": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "x": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "y": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "z": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "intent",
        "bindings"
      ],
      "properties": {
        "kind": {
          "const": "intent"
        },
        "intent": {
          "$ref": "#/$defs/intent_body"
        },
        "bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "target_id"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "target_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "target_point_world_mm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "position": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "point_world_mm"
                    ],
                    "properties": {
                      "kind": {
                        "const": "world_point"
                      },
                      "point_world_mm": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "ifc_class",
                      "order_by",
                      "descending",
                      "ranks",
                      "reference_ids"
                    ],
                    "properties": {
                      "kind": {
                        "const": "between_ranked"
                      },
                      "ifc_class": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
