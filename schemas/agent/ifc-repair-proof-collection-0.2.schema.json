{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2ifc/ifc-repair-proof-collection/0.2",
  "title": "IFC Repair R1 Proof Collection 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance_namespace", "profile", "case_count", "cases"],
  "properties": {
    "schema_version": {"const": "text2ifc/ifc-repair-proof-collection/0.2"},
    "provenance_namespace": {"const": "repair-milestone-r1"},
    "profile": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["case_id", "status", "terminal_class", "case_root", "files", "report", "terminal_record"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"const": "accepted"},
          "terminal_class": {"enum": ["SUCCESS", "CLARIFICATION_THEN_SUCCESS", "INADMISSIBLE_VALUE_OR_CLARIFICATION", "UNSUPPORTED_ATOMIC_GUARD"]},
          "case_root": {"type": "string", "minLength": 1},
          "files": {"type": "string", "minLength": 1},
          "report": {"type": "string", "minLength": 1},
          "terminal_record": {"type": "string", "minLength": 1},
          "source_ifc": {"type": "string", "minLength": 1},
          "repaired_ifc": {"type": "string", "minLength": 1},
          "changeset": {"type": "string", "minLength": 1},
          "application": {"type": "string", "minLength": 1},
          "authority_replay": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
