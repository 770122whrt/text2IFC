{
  "DESIGN_BRIEF": {
    "schema_version": "text2ifc/design-brief/1.0",
    "language": "zh-CN",
    "original_request": "请创建一个单层矩形房间，长6米、宽4米、高3米；四面墙闭合，南墙中央设置一扇宽0.9米、高2.1米的门，北墙中央设置一扇宽1.2米、高1.5米、窗台高0.9米的窗。",
    "known_facts": {
      "room": {
        "type": "single_story",
        "shape": "rectangular",
        "dimensions": {
          "length": 6.0,
          "width": 4.0,
          "height": 3.0
        }
      },
      "walls": {
        "number": 4,
        "closure": "closed",
        "thickness": 0.3
      },
      "doors": [
        {
          "width": 0.9,
          "height": 2.1,
          "position": "center",
          "wall": "south"
        }
      ],
      "windows": [
        {
          "width": 1.2,
          "height": 1.5,
          "position": "center",
          "sill_height": 0.9,
          "wall": "north"
        }
      ]
    },
    "missing_facts": [],
    "ambiguities": [
      {
        "id": "ambiguity1",
        "message": "‘中央’可能指墙的几何中心，或者门的中心线对齐墙的中心线，或者其他点。",
        "options": [
          "center of wall",
          "center line aligned",
          "other"
        ],
        "path": "doors.0.position"
      },
      {
        "id": "ambiguity2",
        "message": "‘中央’可能指墙的几何中心，或者窗的中心线对齐墙的中心线，或者其他点。",
        "options": [
          "center of wall",
          "center line aligned",
          "other"
        ],
        "path": "windows.0.position"
      },
      {
        "id": "ambiguity3",
        "message": "房间的绝对方位（如地理北向）未指定，但提供了相对方向南、北。",
        "options": [
          "assumed north up",
          "user defined orientation",
          "other"
        ],
        "path": "room.orientation"
      }
    ],
    "user_corrections": [
      {
        "path": "walls.thickness",
        "value": 0.3,
        "source_turn": "user_answer"
      }
    ],
    "clarification_questions": [],
    "provenance": {
      "known_facts": [
        "user_original_request",
        "user_answer"
      ],
      "missing_facts": [],
      "ambiguities": [
        "user_original_request"
      ]
    }
  },
  "SCHEMA_SUMMARY": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://text2ifc.local/schemas/bim-json/2.0/schema.json",
    "title": "text2IFC BIM JSON 2.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "ifc_schema",
      "units",
      "entities",
      "relationships",
      "provenance"
    ],
    "properties": {
      "schema_version": {
        "const": "bim-json/2.0"
      },
      "ifc_schema": {
        "const": "IFC2X3"
      },
      "units": {
        "$ref": "#/$defs/units"
      },
      "entities": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/entity"
        }
      },
      "relationships": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/relationship"
        }
      },
      "provenance": {
        "$ref": "#/$defs/provenance"
      }
    },
    "$defs": {
      "nonEmptyString": {
        "type": "string",
        "minLength": 1
      },
      "units": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "length"
        ],
        "properties": {
          "length": {
            "const": "MILLIMETRE"
          }
        }
      },
      "provenance": {
        "type": "object",
        "minProperties": 1
      },
      "vector3": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      },
      "objectPlacement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_to",
          "origin",
          "axis",
          "ref_direction"
        ],
        "properties": {
          "relative_to": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "origin": {
            "$ref": "#/$defs/vector3"
          },
          "axis": {
            "$ref": "#/$defs/vector3"
          },
          "ref_direction": {
            "$ref": "#/$defs/vector3"
          }
        }
      },
      "localPosition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "axis",
          "ref_direction"
        ],
        "properties": {
          "origin": {
            "$ref": "#/$defs/vector3"
          },
          "axis": {
            "$ref": "#/$defs/vector3"
          },
          "ref_direction": {
            "$ref": "#/$defs/vector3"
          }
        }
      },
      "point2": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      },
      "profile": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/point2"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "rectangle"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "x",
                "y"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "polygon"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "points"
              ]
            }
          }
        ]
      },
      "representation": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "profile": {
            "$ref": "#/$defs/profile"
          },
          "depth": {
            "type": "number"
          },
          "direction": {
            "$ref": "#/$defs/vector3"
          },
          "position": {
            "$ref": "#/$defs/localPosition"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "extruded_profile"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "profile",
                "depth",
                "direction"
              ]
            }
          }
        ]
      },
      "materialLayer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "thickness"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "materialAssignment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "layer_set_name",
          "direction",
          "direction_sense",
          "offset_from_reference_line",
          "layers"
        ],
        "properties": {
          "kind": {
            "const": "material_layer_set_usage"
          },
          "layer_set_name": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "direction": {
            "enum": [
              "AXIS1",
              "AXIS2",
              "AXIS3"
            ]
          },
          "direction_sense": {
            "enum": [
              "POSITIVE",
              "NEGATIVE"
            ]
          },
          "offset_from_reference_line": {
            "type": "number"
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/materialLayer"
            }
          }
        }
      },
      "attributes": {
        "type": "object",
        "properties": {
          "ObjectPlacement": {
            "$ref": "#/$defs/objectPlacement"
          },
          "Representation": {
            "$ref": "#/$defs/representation"
          }
        }
      },
      "entity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ifc_class",
          "attributes",
          "property_sets",
          "provenance"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "ifc_class": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "global_id": {},
          "attributes": {
            "$ref": "#/$defs/attributes"
          },
          "materials": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/materialAssignment"
            }
          },
          "property_sets": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      },
      "relationship": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ifc_class",
          "attributes",
          "provenance"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "ifc_class": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "global_id": {},
          "attributes": {
            "type": "object"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    }
  },
