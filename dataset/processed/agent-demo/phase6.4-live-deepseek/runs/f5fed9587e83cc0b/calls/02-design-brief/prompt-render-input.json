    "$id": "https://text2ifc.local/schemas/agent/design-brief/2.0/schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "needs_clarification"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "clarification_questions": {
              "maxItems": 3,
              "minItems": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "clarification_questions": {
              "maxItems": 0
            }
          }
        }
      }
    ],
