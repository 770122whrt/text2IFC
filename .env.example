# Active OpenAI-compatible provider
TEXT2IFC_PROVIDER=deepseek

# DeepSeek credentials and endpoint
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=
TEXT2IFC_DEEPSEEK_MODEL=deepseek-v4-flash

# Native DSH web search: freeze with --d-web-search in a new batch.
# Blank search key reuses DEEPSEEK_API_KEY only for api.deepseek.com.
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_SEARCH_API_KEY=

# Optional runtime controls
TEXT2IFC_DEEPSEEK_MAX_TOKENS=65536
TEXT2IFC_DEEPSEEK_MAX_INPUT_TOKENS=65536
TEXT2IFC_PROVIDER_TIMEOUT_SECONDS=1800
